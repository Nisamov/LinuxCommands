server {
    listen 80;
    server_name {{ domain_name }} www.{{ domain_name }};
    root {{ web_root }};
    index index.html index.htm;

    location / {
        try_files $uri $uri/ =404;
    }
}

server {
    listen 443 ssl;
    server_name {{ domain_name }} www.{{ domain_name }};
    root {{ web_root }};
    index index.html index.htm;

    ssl_certificate {{ ssl_cert_path }}/certificado.crt;
    ssl_certificate_key {{ ssl_cert_path }}/clave_privada.key;

    location / {
        try_files $uri $uri/ =404;
    }
}